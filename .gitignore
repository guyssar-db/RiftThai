node_modules
/.svelte-kit
/build
/bin
/.vite
/.vercel
/.netlify
.turbo
coverage/
playwright-report/
test-results/
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.lnk
.vscode/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore all scripts and config files except the essential ones
*.js
*.cjs
!svelte.config.js
!eslint.config.js
!vite.config.ts

# Ignore all JSON files in the root (mostly processing batches)
/*.json
!package.json
!package-lock.json
!tsconfig.json

# Allow data files inside src
!src/lib/data/*.json
src/lib/data/riftbound_cards_all_backup.json

# Ignore temporary directories
temp_chunks/
.output/
dev-server.*
dev-server*.log
dev-server*.err

# Ignore unused components
src/lib/components/TurnPhasesModal.svelte

# Documentation
*.md
!README.md
!core_rules.md
!GEMINI.md
!docs/
!docs/*.md
docs/rag-ingest-*.md
docs/site-structure.html
!skills/
!skills/**/*.md
!skills/**/*.yaml

# Ensure images in static/images and static/image are ALWAYS included
!static/images/
!static/images/**/*.png
!static/images/**/*.jpg
!static/images/**/*.jpeg
!static/images/**/*.gif
!static/images/**/*.svg
!static/images/**/*.webp
!static/images/**/*.avif
!static/images/**/*.ico
!static/image/
!static/image/**/*.avif

# Ignore temporary unused utility scripts
download_and_convert.js
update_json_images.js
