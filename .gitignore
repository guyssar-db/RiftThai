node_modules
/.svelte-kit
/build
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/

# Ignore all scripts and config files except the essential ones
*.js
*.cjs
!svelte.config.js
!eslint.config.js
!vite.config.ts

# Ignore all JSON files in the root (mostly processing batches)
/*.json
!package.json
!package-lock.json
!tsconfig.json

# Allow data files inside src
!src/lib/data/*.json
src/lib/data/riftbound_cards_all_backup.json

# Ignore temporary directories
temp_chunks/
.output/
dev-server.*
dev-server*.log
dev-server*.err

# Ignore unused components
src/lib/components/TurnPhasesModal.svelte

# Documentation
*.md
!README.md
!core_rules.md
!GEMINI.md
!docs/
!docs/*.md
!skills/
!skills/**/*.md
!skills/**/*.yaml

# Ensure images are ALWAYS included
!static/images/
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp
!*.avif
!*.ico
